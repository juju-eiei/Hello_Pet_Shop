DB_HOST=localhost
DB_NAME=hello_pet_shop
DB_USER=root
DB_PASS=
# Generate a long random secret for every environment; never use a placeholder in production.
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=localhost

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://hello_pet_shop.test,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
LINE_CHANNEL_SECRET=

# Mail Settings (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
FROM_EMAIL=YOUR_GMAIL_ADDRESS@gmail.com
FROM_NAME=Hello Pet Shop
