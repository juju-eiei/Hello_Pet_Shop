DB_HOST=localhost
DB_NAME=hello_pet_shop
DB_USER=root
DB_PASS=
# Generate a long random secret for every environment; never use a placeholder in production.
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=localhost

# Mail Settings (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
FROM_EMAIL=YOUR_GMAIL_ADDRESS@gmail.com
FROM_NAME=Hello Pet Shop
